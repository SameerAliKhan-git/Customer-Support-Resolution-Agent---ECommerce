# Local development defaults. See docs/AGENT_HANDOFF.md before staging or production use.
ENVIRONMENT=development
AUTH_MODE=demo
ASYNC_WORKFLOWS=false
SEED_DEMO_DATA=true
AUTO_CREATE_SCHEMA=true

# Application data and LangGraph checkpoints. DATABASE_URL and
# SYNC_DATABASE_URL must address the same database.
DATABASE_URL=sqlite+aiosqlite:///./support_agent.db
SYNC_DATABASE_URL=sqlite:///./support_agent.db
CHECKPOINT_DATABASE_URL=sqlite:///./checkpoints.db

# Set a long random private value before AUTH_MODE=signed. Signed mode is a
# test facility; production should use AUTH_MODE=oidc.
SECRET_KEY=super-secret-dev-key-change-in-prod-xyz789
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production identity settings. OIDC_ISSUER must be the exact HTTPS issuer URL.
OIDC_ISSUER=
OIDC_AUDIENCE=support-api
OIDC_CLIENT_ID=support-portal
OIDC_REQUIRE_STAFF_MFA=true
OIDC_REVIEW_LIMIT_MINOR=50000

# Payment adapter. Keep mock locally. Use only Stripe test credentials until
# the sandbox failure matrix in docs/AGENT_HANDOFF.md has passed.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_TIMEOUT_MS=3000
# Mock-provider failure injection used by local tests and demonstrations.
SIMULATE_TIMEOUT_FOR_KEY_PREFIX=timeout_test_
SIMULATE_FAILURE_FOR_KEY_PREFIX=fail_test_

# Generic ecommerce bridge. The remote service must support the contracts
# documented in docs/OPERATIONS.md.
INTEGRATION_BASE_URL=
INTEGRATION_API_TOKEN=

# Request and policy controls.
REQUESTS_PER_MINUTE=120
POLICY_MIN_LEXICAL_OVERLAP=0.12

# Store and approval settings. Amounts are integer minor currency units.
STORE_NAME=ElectroVault Global
CURRENCY=USD
MAX_AUTO_REFUND_LIMIT_MINOR=0
PROPOSAL_EXPIRY_HOURS=48

# Optional model classifier. The deterministic offline baseline is the default.
# Only the OpenAI classifier is currently implemented.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
